<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="MK-Mail"
           Language="1033"
           Version="$(var.AppVersion)"
           Manufacturer="MK-Mail"
           UpgradeCode="4E743A21-4F28-4E89-B62F-8E649F568C32">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="MK-Mail for Windows x64 (POP3/IMAP/SMTP)" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of MK-Mail is already installed." AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/tuandang84/MK-Mail" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="MK-Mail" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="MK-Mail" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="7C8D1234-A12B-456C-D89E-F12345678901" Win64="yes">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="MK-Mail"
                  Description="MK-Mail with POP3 and IMAP Support"
                  Target="[INSTALLFOLDER]$(var.ExeName)"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="CleanUpStartMenuShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\MK-Mail" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="8D9E2345-B23C-567D-E90F-012345678912" Win64="yes">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="MK-Mail"
                  Description="MK-Mail with POP3 and IMAP Support"
                  Target="[INSTALLFOLDER]$(var.ExeName)"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\MK-Mail" Name="desktop_shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="MK-Mail" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Product>
</Wix>
